<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EmberPane.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The few colours Windows has no name for. The flyout's surfaces
                are Fluent's solid page colours at 88%: the stock layer fills
                are made for a layer inside a window, and over bare acrylic
                they let the wallpaper behind the panel set its colour.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.88" />
                    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="{ThemeResource SolidBackgroundFillColorSecondary}" Opacity="0.88" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.88" />
                    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="{ThemeResource SolidBackgroundFillColorSecondary}" Opacity="0.88" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                A flat button that only fills on hover, as the gear in the
                Quick Settings footer does. Lightweight styling over the stock
                template, so focus visuals and pressed states stay Windows'.
            -->
            <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
            </Style>

            <!--
                Secondary caption text for elements built in code. A brush
                looked up from code is fixed to one theme; a setter's
                ThemeResource follows the element's.
            -->
            <Style x:Key="SecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DisabledText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="SecondaryIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
                A line across a card's body, edge to edge like the one under
                its header: the card's padding is 16, so it bleeds by that.
            -->
            <Style x:Key="CardDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="-16,0,-16,0" />
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- The heading over a group of cards, as in Windows Settings. -->
            <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
