#include "AppIcon.h"

IDI_APP ICON "Assets/EmberPane.ico"

// The name Windows shows for the exe: Task Manager, the startup apps list,
// and the file's properties. Without it they fall back to "EmberPane.exe".
1 VERSIONINFO
FILEVERSION 1,1,6,0
PRODUCTVERSION 1,1,6,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Ember Pane"
            VALUE "ProductName", "Ember Pane"
            VALUE "FileVersion", "1.1.6.0"
            VALUE "ProductVersion", "1.1.6.0"
            VALUE "OriginalFilename", "EmberPane.exe"
            VALUE "InternalName", "EmberPane"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
