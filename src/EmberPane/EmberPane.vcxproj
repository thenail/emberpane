<?xml version="1.0" encoding="utf-8"?>
<!--
  Based on Visual Studio's "WinUI Blank App (C++/WinRT)" template, changed to
  run UNPACKAGED (a plain .exe, no MSIX), which is what a tray utility that
  starts with Windows wants.
-->
